@using TransparentAiAgentCore.Domain.UIControl
@using TransparentAiAgentGui.Services
@implements IDisposable
@inject IUIControlService UIControlService
@inject global::TransparentAiAgentCore.Domain.UIControl.IAppModeService AppModeService
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TransparentAiAgentGui</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Mode Toggle Section -->
        <hr class="nav-divider" />

        <div class="nav-section-header px-3">
            <small class="text-muted">MODE</small>
        </div>

        <div class="nav-item px-3 mode-toggle-container">
            <div class="mode-toggle">
                <span class="mode-label @(_uiState.CurrentMode == AppMode.Normal ? "active" : "")">Normal</span>
                <button class="mode-switch @(_uiState.CurrentMode == AppMode.Teaching ? "teaching" : "normal")"
                        @onclick="ToggleMode"
                        @onclick:stopPropagation="true"
                        disabled="@_isSwitchingMode"
                        title="Switch between Normal and Teaching mode">
                    <span class="switch-slider"></span>
                </button>
                <span class="mode-label @(_uiState.CurrentMode == AppMode.Teaching ? "active" : "")">Teaching</span>
            </div>
            @if (_isSwitchingMode)
            {
                <small class="text-muted">Switching mode...</small>
            }
        </div>

        <!-- Overlay Controls Section -->
        <hr class="nav-divider" />

        <div class="nav-section-header px-3">
            <small class="text-muted">OVERLAYS</small>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link overlay-toggle @(_uiState.TransparencyViewer.Visible ? "active" : "")"
                    @onclick="ToggleTransparencyViewer"
                    @onclick:stopPropagation="true">
                <span class="bi bi-eye-fill" aria-hidden="true"></span> Transparency
                <span class="toggle-indicator">@(_uiState.TransparencyViewer.Visible ? "▼" : "▶")</span>
            </button>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link overlay-toggle @(_uiState.ToolsPanel.Visible ? "active" : "")"
                    @onclick="ToggleToolsPanel"
                    @onclick:stopPropagation="true">
                <span class="bi bi-tools" aria-hidden="true"></span> Tools
                <span class="toggle-indicator">@(_uiState.ToolsPanel.Visible ? "▼" : "▶")</span>
            </button>
        </div>

        <div class="nav-item px-3">
            <button class="nav-link overlay-toggle @(_uiState.ConfigurationPage.Visible ? "active" : "")"
                    @onclick="ToggleConfiguration"
                    @onclick:stopPropagation="true">
                <span class="bi bi-gear-fill" aria-hidden="true"></span> Configuration
                <span class="toggle-indicator">@(_uiState.ConfigurationPage.Visible ? "▼" : "▶")</span>
            </button>
        </div>

        @if (_uiState.CurrentMode == AppMode.Teaching)
        {
            <div class="nav-item px-3">
                <button class="nav-link overlay-toggle @(_uiState.ScenarioSelector.Visible ? "active" : "")"
                        @onclick="ToggleScenarioSelector"
                        @onclick:stopPropagation="true">
                    <span class="bi bi-book" aria-hidden="true"></span> Scenarios
                    <span class="toggle-indicator">@(_uiState.ScenarioSelector.Visible ? "▼" : "▶")</span>
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private UIState _uiState = UIState.DefaultNormalMode();
    private bool _isSwitchingMode = false;

    protected override void OnInitialized()
    {
        UIControlService.UIStateChanged += OnUIStateChanged;
        AppModeService.ModeChanged += OnModeChanged;
        _uiState = UIControlService.GetCurrentState();
    }

    private void OnUIStateChanged(object? sender, UIState newState)
    {
        InvokeAsync(() =>
        {
            _uiState = newState;
            StateHasChanged();
        });
    }

    private void OnModeChanged(object? sender, AppMode newMode)
    {
        InvokeAsync(() =>
        {
            _isSwitchingMode = false;
            StateHasChanged();
        });
    }

    private async Task ToggleMode()
    {
        if (_isSwitchingMode) return;

        _isSwitchingMode = true;
        StateHasChanged();

        try
        {
            var targetMode = _uiState.CurrentMode == AppMode.Normal ? AppMode.Teaching : AppMode.Normal;
            await AppModeService.SwitchModeAsync(targetMode);
        }
        catch (Exception ex)
        {
            // TODO: Show error to user
            Console.WriteLine($"Failed to switch mode: {ex.Message}");
            _isSwitchingMode = false;
            StateHasChanged();
        }
    }

    private void ToggleTransparencyViewer()
    {
        UIControlService.UpdateTransparencyViewer(visible: !_uiState.TransparencyViewer.Visible);
    }

    private void ToggleToolsPanel()
    {
        UIControlService.UpdateToolsPanel(visible: !_uiState.ToolsPanel.Visible);
    }

    private void ToggleConfiguration()
    {
        UIControlService.UpdateConfigurationPage(visible: !_uiState.ConfigurationPage.Visible);
    }

    private void ToggleScenarioSelector()
    {
        UIControlService.UpdateScenarioSelector(visible: !_uiState.ScenarioSelector.Visible);
    }

    public void Dispose()
    {
        UIControlService.UIStateChanged -= OnUIStateChanged;
        AppModeService.ModeChanged -= OnModeChanged;
    }
}
