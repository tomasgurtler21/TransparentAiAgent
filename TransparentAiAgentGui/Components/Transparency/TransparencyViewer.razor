@using TransparentAiAgentCore.Domain.Transparency
@using TransparentAiAgentCore.Infrastructure.Transparency
@using TransparentAiAgentCore.Domain.UIControl
@using Microsoft.JSInterop
@implements IDisposable
@inject ITransparencyService TransparencyService
@inject IUIControlService UIControlService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@if (_uiState.TransparencyViewer.Visible)
{
<div class="transparency-viewer">
    <div class="viewer-header">
        <div class="viewer-header-top">
            <h3>Transparency Events</h3>
            <button class="viewer-close-btn" @onclick="HandleClose">×</button>
        </div>
        <div class="viewer-controls">
            <input type="text"
                   class="search-input"
                   placeholder="Search events..."
                   @bind="SearchQuery"
                   @bind:event="oninput" />

            <div class="event-filters">
                @foreach (var filter in EventTypeFilters)
                {
                    <div class="filter-item">
                        <select @bind="filter.SelectedType" class="filter-select">
                            <option value="">All Events</option>
                            @foreach (TransparencyEventType eventType in Enum.GetValues<TransparencyEventType>())
                            {
                                <option value="@eventType">@eventType</option>
                            }
                        </select>

                        @if (EventTypeFilters.Count > 1)
                        {
                            <button @onclick="() => RemoveFilter(filter)"
                                    class="btn-remove-filter"
                                    title="Remove filter">✕</button>
                        }
                    </div>
                }

                <button @onclick="AddFilter" class="btn-add-filter">
                    + Add Filter
                </button>
            </div>

            <label class="auto-scroll-label">
                <input type="checkbox" @bind="AutoScroll" />
                Auto-scroll
            </label>

            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearEvents">
                Clear
            </button>

            <button class="btn btn-sm btn-primary" @onclick="HandleExportClick">
                Save
            </button>
        </div>
    </div>

    <div class="viewer-stats">
        <span>Total: @Events.Count</span>
        <span>Filtered: @FilteredEvents.Count</span>
    </div>

    <div class="viewer-content" @ref="ViewerContentRef">
        @if (!FilteredEvents.Any())
        {
            <div class="no-events">
                <p>No events to display</p>
            </div>
        }
        else
        {
            @foreach (TransparencyEvent ev in FilteredEvents)
            {
                <TransparencyEventDisplay @key="ev.Id" Event="ev" ShowTimestamp="@_uiState.TransparencyViewer.ShowTimestamps" />
            }
        }
    </div>
</div>
}

@code {
    private UIState _uiState = UIState.DefaultNormalMode();
    private List<TransparencyEvent> Events { get; set; } = new();
    private string SearchQuery { get; set; } = string.Empty;
    private List<EventTypeFilter> EventTypeFilters { get; set; } = new()
    {
        new EventTypeFilter() // Start with one empty filter
    };
    private bool AutoScroll { get; set; } = true;
    private ElementReference ViewerContentRef;

    private class EventTypeFilter
    {
        public string SelectedType { get; set; } = string.Empty;
    }

    private List<TransparencyEvent> FilteredEvents
    {
        get
        {
            IEnumerable<TransparencyEvent> filtered = Events;

            // Apply UI state event type filters if any (for teaching mode/programmatic control)
            if (_uiState.TransparencyViewer.EventTypeFilters.Any())
            {
                filtered = filtered.Where(e =>
                    _uiState.TransparencyViewer.EventTypeFilters.Contains(e.EventType.ToString()));
            }

            // Apply multi-filter (OR logic)
            var selectedTypes = EventTypeFilters
                .Where(f => !string.IsNullOrEmpty(f.SelectedType))
                .Select(f => f.SelectedType)
                .ToList();

            if (selectedTypes.Any())
            {
                filtered = filtered.Where(e => selectedTypes.Contains(e.EventType.ToString()));
            }

            // Apply search filter
            filtered = filtered.Where(e =>
                string.IsNullOrEmpty(SearchQuery) ||
                e.EventType.ToString().Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.AdditionalInfo?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) == true ||
                e.Data?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) == true);

            return filtered.ToList();
        }
    }

    protected override void OnInitialized()
    {
        // Load existing events
        Events = TransparencyService.GetRecentEvents(10000).ToList();

        // Subscribe to new events
        TransparencyService.EventLogged += OnEventLogged;

        // Subscribe to UI state changes
        UIControlService.UIStateChanged += OnUIStateChanged;
        _uiState = UIControlService.GetCurrentState();
    }

    private void OnUIStateChanged(object? sender, UIState newState)
    {
        InvokeAsync(() =>
        {
            _uiState = newState;
            StateHasChanged();
        });
    }

    private async void OnEventLogged(object? sender, TransparencyEvent e)
    {
        Events.Add(e);

        // Limit to 10000 events to prevent memory issues
        if (Events.Count > 10000)
        {
            Events.RemoveAt(0);
        }

        await InvokeAsync(async () =>
        {
            StateHasChanged();

            if (AutoScroll)
            {
                await ScrollToBottom();
            }
        });
    }

    private async Task ScrollToBottom()
    {
        try
        {
            // Use JS interop to scroll to bottom
            await JSRuntime.InvokeVoidAsync("scrollToBottom", ViewerContentRef);
        }
        catch (Exception)
        {
            // Ignore JS errors (e.g., if element not found)
        }
    }

    private void ClearEvents()
    {
        Events.Clear();
        StateHasChanged();
    }

    private void AddFilter()
    {
        EventTypeFilters.Add(new EventTypeFilter());
    }

    private void RemoveFilter(EventTypeFilter filter)
    {
        if (EventTypeFilters.Count > 1) // Keep at least one filter
        {
            EventTypeFilters.Remove(filter);
        }
    }

    private async Task HandleClose()
    {
        // Close via UIControlService
        await Task.Run(() =>
            UIControlService.UpdateTransparencyViewer(visible: false));
    }

    private async Task HandleExportClick()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Logs contain all message content. Ensure no sensitive information before exporting. Continue?");

        if (confirmed)
        {
            await ExportToJson();
        }
    }

    private async Task ExportToJson()
    {
        try
        {
            // Export ALL events from TransparencyService (not just the UI's limited list)
            var allEvents = TransparencyService.GetEvents().ToList();

            var export = new
            {
                exportedAt = DateTime.UtcNow,
                totalEventsExported = allEvents.Count,
                eventsInViewer = Events.Count,
                events = allEvents
            };

            var json = System.Text.Json.JsonSerializer.Serialize(export, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
            });

            var filename = $"transparency-events-{DateTime.UtcNow:yyyy-MM-dd-HHmmss}.json";
            await JSRuntime.InvokeVoidAsync("downloadFile", filename, json);
        }
        catch (Exception ex)
        {
            // Log error but don't crash UI
            Console.WriteLine($"Export failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        TransparencyService.EventLogged -= OnEventLogged;
        UIControlService.UIStateChanged -= OnUIStateChanged;
    }
}
