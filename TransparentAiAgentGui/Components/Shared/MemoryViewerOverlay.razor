@using TransparentAiAgentCore.Domain.Memory
@using TransparentAiAgentCore.Domain.UIControl
@using Markdig
@using Microsoft.Extensions.Logging
@inject ILongTermMemoryService MemoryService
@inject global::TransparentAiAgentCore.Domain.UIControl.IAppModeService AppModeService
@inject ILogger<MemoryViewerOverlay> Logger

@if (isVisible)
{
    <div class="overlay" @onclick="Close">
        <div class="overlay-content memory-viewer" @onclick:stopPropagation>
            <div class="overlay-header">
                <h3>Long-Term Memory (@CurrentMode Mode)</h3>
                <button class="btn-close" @onclick="Close">✕</button>
            </div>

            <div class="overlay-body">
                @if (isEditing)
                {
                    <div class="memory-editor-container">
                        <textarea class="memory-editor"
                                  @bind="editedContent"
                                  @bind:event="oninput"
                                  rows="20"></textarea>

                        <div class="character-count @(editedContent.Length > maxCharacters ? "over-limit" : "")">
                            <span>@editedContent.Length / @maxCharacters.ToString("N0") characters</span>
                            @if (editedContent.Length > maxCharacters)
                            {
                                <span class="error-message">⚠️ Exceeds limit</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @if (string.IsNullOrWhiteSpace(memoryContent))
                    {
                        <div class="empty-memory-message">
                            <p>No memory stored yet for @CurrentMode mode.</p>
                            <p>The AI agent can store important information about you, your preferences, and context from your conversations.</p>
                        </div>
                    }
                    else
                    {
                        <div class="memory-display markdown-content">
                            @((MarkupString)renderedMarkdown)
                        </div>
                    }
                }
            </div>

            <div class="overlay-footer">
                @if (isEditing)
                {
                    <button class="btn btn-primary" @onclick="SaveChanges" disabled="@(editedContent.Length > maxCharacters)">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelEditing">Cancel</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="StartEditing">Edit</button>
                    <button class="btn btn-secondary" @onclick="Close">Close</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible = false;
    private bool isEditing = false;
    private string memoryContent = string.Empty;
    private string editedContent = string.Empty;
    private string renderedMarkdown = string.Empty;
    private int maxCharacters = 10000;
    private AppMode CurrentMode => AppModeService.CurrentMode;

    protected override void OnInitialized()
    {
        // Get max characters from configuration (injected via MemoryService)
        // Using default 10,000 for now
        maxCharacters = 10000;
    }

    public async Task ShowAsync()
    {
        memoryContent = await MemoryService.ReadMemoryAsync(CurrentMode);
        editedContent = memoryContent;
        renderedMarkdown = RenderMarkdown(memoryContent);
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        isEditing = false;
        StateHasChanged();
    }

    private void StartEditing()
    {
        editedContent = memoryContent;
        isEditing = true;
    }

    private void CancelEditing()
    {
        isEditing = false;
        editedContent = memoryContent;
    }

    private async Task SaveChanges()
    {
        var result = await MemoryService.UpdateMemoryAsync(CurrentMode, editedContent);

        if (result.Success)
        {
            memoryContent = editedContent;
            renderedMarkdown = RenderMarkdown(memoryContent);
            isEditing = false;
            Logger.LogInformation("Memory updated successfully ({CharCount} chars)", result.CharacterCount);
        }
        else
        {
            // Log error to console and transparency
            Logger.LogError("Failed to save memory: {Error}", result.Error);
            // Error visible in transparency events and browser console
        }

        StateHasChanged();
    }

    private string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        try
        {
            // Use Markdig pipeline with advanced extensions (same as MarkdownDisplay component)
            var pipeline = new MarkdownPipelineBuilder()
                .UseAdvancedExtensions()
                .Build();

            return Markdown.ToHtml(markdown, pipeline);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to render markdown");
            // If markdown parsing fails, return escaped content
            return System.Net.WebUtility.HtmlEncode(markdown);
        }
    }
}
