@using TransparentAiAgentGui.Models
@using TransparentAiAgentGui.Components.Chat
@using TransparentAiAgentCore.Domain.UIControl
@implements IDisposable
@inject IUIControlService UIControlService

<div class="message @Message.CssClass">
    <div class="message-header">
        <span class="message-role">@GetRoleDisplayName()</span>
        @if (Message.IsToolCall)
        {
            <span class="tool-indicator">🔧</span>
        }
        @if (Message.IsToolResult)
        {
            <span class="tool-result-indicator">@(Message.ToolResultSuccess ? "✅" : "❌")</span>
        }
        @if (Message.IsAutoMessage)
        {
            <span class="auto-message-indicator" title="Auto-sent by scenario">🎬</span>
        }
        @if (_uiState.ContextIndicators.Visible)
        {
            <span class="message-context-status @(_uiState.ContextIndicators.Highlighted ? "highlighted" : "")">
                @Message.ContextStatusIcon
            </span>
        }
        <span class="message-timestamp">@Message.Timestamp.ToString("HH:mm:ss")</span>
    </div>
    <div class="message-content">
        @* Display thinking content if present *@
        @if (!string.IsNullOrWhiteSpace(Message.Thinking))
        {
            <details class="thinking-section">
                <summary class="thinking-summary">💭 Model's Thinking</summary>
                <div class="thinking-content">
                    <MarkdownDisplay Content="@Message.Thinking" />
                </div>
            </details>
        }

        @if (Message.IsToolCall)
        {
            <div class="tool-call-container">
                @* Display text content if present (Anthropic often sends text with tool calls) *@
                @if (!string.IsNullOrWhiteSpace(Message.Content))
                {
                    <div class="tool-call-content">
                        <MarkdownDisplay Content="@Message.Content" />
                    </div>
                }

                @* CONDITIONALLY display tool call details based on filter *@
                @if (_uiState.ChatFilter.ShowToolCalls)
                {
                    @foreach (var toolCall in Message.ToolCalls)
                    {
                        <div class="tool-call">
                            <div class="tool-name">Tool: <strong>@toolCall.Name</strong></div>
                            @if (!string.IsNullOrWhiteSpace(toolCall.Arguments))
                            {
                                <JsonDisplay Content="@toolCall.Arguments" Title="Arguments" InitiallyExpanded="false" />
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (Message.IsToolResult)
        {
            <div class="tool-result">
                <div class="tool-name">Result from: <strong>@Message.ToolName</strong></div>
                @if (!string.IsNullOrWhiteSpace(Message.ToolErrorMessage))
                {
                    <div class="tool-error">Error: @Message.ToolErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(Message.Content))
                {
                    <JsonDisplay Content="@Message.Content"
                                Title="@(Message.ToolResultSuccess ? "Success" : "Failed")"
                                InitiallyExpanded="false" />
                }
            </div>
        }
        else if (Message.Role == TransparentAiAgentCore.Domain.Enums.MessageRole.Assistant)
        {
            <MarkdownDisplay Content="@Message.Content" />
        }
        else
        {
            @Message.Content
        }
    </div>

    @* Display annotation if present *@
    @if (!string.IsNullOrWhiteSpace(Message.Annotation))
    {
        <div class="message-annotation">
            <span class="annotation-icon">💡</span>
            <span class="annotation-text">@Message.Annotation</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The message to display.
    /// </summary>
    [Parameter, EditorRequired]
    public UIMessage Message { get; set; } = null!;

    private UIState _uiState = UIState.DefaultNormalMode();

    protected override void OnInitialized()
    {
        UIControlService.UIStateChanged += OnUIStateChanged;
        _uiState = UIControlService.GetCurrentState();
    }

    private void OnUIStateChanged(object? sender, UIState newState)
    {
        InvokeAsync(() =>
        {
            _uiState = newState;
            StateHasChanged();
        });
    }

    private string GetRoleDisplayName()
    {
        // For tool calls, show different label based on filter state
        if (Message.IsToolCall)
        {
            // When tool calls are hidden, show "Assistant" (less confusing for users)
            // When tool calls are visible, show "Tool Call" (accurate label)
            return _uiState.ChatFilter.ShowToolCalls ? "Tool Call" : "Assistant";
        }

        if (Message.IsToolResult) return "Tool Result";

        return Message.Role.ToString();
    }

    public void Dispose()
    {
        UIControlService.UIStateChanged -= OnUIStateChanged;
    }
}
