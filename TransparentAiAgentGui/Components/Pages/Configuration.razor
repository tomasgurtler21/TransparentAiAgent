@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization
@using TransparentAiAgentCore.Domain.UIControl
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IUIControlService UIControlService

@if (_uiState.ConfigurationPage.Visible)
{
<div class="configuration-page">
    <div class="config-header">
        <h3>Agent Configuration</h3>
        <button class="config-close-btn" @onclick="HandleClose">×</button>
    </div>

    @if (IsLoading)
    {
        <p><em>Loading configuration...</em></p>
    }
    else if (LoadError != null)
    {
        <div class="alert alert-danger">
            <strong>Error loading configuration:</strong> @LoadError
        </div>
    }
    else
    {
        <div class="configuration-section @(_uiState.ConfigurationPage.HighlightedSection == "SystemPrompt" ? "highlighted" : "")">
            <h4>System Prompt</h4>
            <div class="form-group">
                <textarea @bind="EditedSystemPrompt"
                          @bind:event="oninput"
                          rows="10"
                          class="form-control @(SystemPromptError != null ? "is-invalid" : "")"
                          placeholder="Enter system prompt...">
                </textarea>
                <small class="form-text text-muted">@EditedSystemPrompt?.Length ?? 0 characters</small>
                @if (SystemPromptError != null)
                {
                    <div class="invalid-feedback d-block">@SystemPromptError</div>
                }
            </div>
            <div class="mt-2">
                <button @onclick="SaveSystemPromptAsync"
                        disabled="@(IsSavingSystemPrompt || !HasSystemPromptChanges)"
                        class="btn btn-primary">
                    @(IsSavingSystemPrompt ? "Saving..." : "Save System Prompt")
                </button>
                <button @onclick="ReloadConfiguration"
                        disabled="@IsSavingSystemPrompt"
                        class="btn btn-secondary ms-2">
                    Cancel
                </button>
            </div>
            @if (SystemPromptSuccess)
            {
                <div class="alert alert-success mt-2">
                    System prompt updated successfully!
                </div>
            }
        </div>

        <hr class="my-4" />

        <div class="configuration-section @(_uiState.ConfigurationPage.HighlightedSection == "AgentConfiguration" ? "highlighted" : "")">
            <h4>Agent Configuration</h4>
            <div class="form-group">
                <label>Context Window Size</label>
                <input type="number"
                       @bind="ContextWindowSize"
                       @bind:event="oninput"
                       min="1"
                       max="100"
                       class="form-control" />
                <small class="form-text text-muted">Number of recent messages to include in conversation context</small>
                @if (AgentConfigError != null)
                {
                    <div class="text-danger">@AgentConfigError</div>
                }
            </div>

            <div class="mt-3">
                <button @onclick="SaveAgentConfigAsync"
                        disabled="@(IsSavingAgentConfig || !HasAgentConfigChanges)"
                        class="btn btn-primary">
                    @(IsSavingAgentConfig ? "Saving..." : "Save Agent Configuration")
                </button>
                <button @onclick="ReloadConfiguration"
                        disabled="@IsSavingAgentConfig"
                        class="btn btn-secondary ms-2">
                    Cancel
                </button>
            </div>
            @if (AgentConfigSuccess)
            {
                <div class="alert alert-success mt-2">
                    Agent configuration updated successfully!
                </div>
            }
        </div>

        <hr class="my-4" />

        <div class="configuration-section @(_uiState.ConfigurationPage.HighlightedSection == "LLMParameters" ? "highlighted" : "")">
            <h4>LLM Parameters</h4>
            <div class="form-group">
                <label>Temperature</label>
                <input type="number"
                       @bind="Temperature"
                       @bind:event="oninput"
                       min="0.0"
                       max="2.0"
                       step="0.1"
                       class="form-control" />
                <small class="form-text text-muted">Controls randomness (0.0 = deterministic, 2.0 = very random)</small>
            </div>

            <div class="form-group mt-3">
                <label>Max Tokens</label>
                <input type="number"
                       @bind="MaxTokens"
                       @bind:event="oninput"
                       min="1"
                       max="128000"
                       class="form-control" />
                <small class="form-text text-muted">Maximum response length</small>
            </div>

            <div class="form-group mt-3">
                <label>Top-P</label>
                <input type="number"
                       @bind="TopP"
                       @bind:event="oninput"
                       min="0.0"
                       max="1.0"
                       step="0.05"
                       class="form-control" />
                <small class="form-text text-muted">Nucleus sampling threshold (0.0 = narrow, 1.0 = wide)</small>
                @if (LLMParametersError != null)
                {
                    <div class="text-danger">@LLMParametersError</div>
                }
            </div>

            <div class="mt-3">
                <button @onclick="SaveLLMParametersAsync"
                        disabled="@(IsSavingLLMParameters || !HasLLMParametersChanges)"
                        class="btn btn-primary">
                    @(IsSavingLLMParameters ? "Saving..." : "Save LLM Parameters")
                </button>
                <button @onclick="ReloadConfiguration"
                        disabled="@IsSavingLLMParameters"
                        class="btn btn-secondary ms-2">
                    Cancel
                </button>
            </div>
            @if (LLMParametersSuccess)
            {
                <div class="alert alert-success mt-2">
                    LLM parameters updated successfully!
                </div>
            }
        </div>
    }
</div>
}

@code {
    private UIState _uiState = UIState.DefaultNormalMode();
    private bool IsLoading = true;
    private string? LoadError;

    private string? OriginalSystemPrompt;
    private string? EditedSystemPrompt;
    private bool IsSavingSystemPrompt;
    private bool SystemPromptSuccess;
    private string? SystemPromptError;

    private int OriginalContextWindowSize;
    private int ContextWindowSize;
    private bool IsSavingAgentConfig;
    private bool AgentConfigSuccess;
    private string? AgentConfigError;

    private double OriginalTemperature;
    private int OriginalMaxTokens;
    private double OriginalTopP;

    private double Temperature;
    private int MaxTokens;
    private double TopP;

    private bool IsSavingLLMParameters;
    private bool LLMParametersSuccess;
    private string? LLMParametersError;

    // JSON options with InvariantCulture to handle locale-specific number formats
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private bool HasSystemPromptChanges => EditedSystemPrompt != OriginalSystemPrompt;
    private bool HasAgentConfigChanges => ContextWindowSize != OriginalContextWindowSize;
    private bool HasLLMParametersChanges =>
        Temperature != OriginalTemperature ||
        MaxTokens != OriginalMaxTokens ||
        TopP != OriginalTopP;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to UI state changes
        UIControlService.UIStateChanged += OnUIStateChanged;
        _uiState = UIControlService.GetCurrentState();

        await ReloadConfiguration();
    }

    private void OnUIStateChanged(object? sender, UIState newState)
    {
        InvokeAsync(() =>
        {
            _uiState = newState;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        UIControlService.UIStateChanged -= OnUIStateChanged;
    }

    private async Task ReloadConfiguration()
    {
        IsLoading = true;
        LoadError = null;
        SystemPromptSuccess = false;
        AgentConfigSuccess = false;
        LLMParametersSuccess = false;
        SystemPromptError = null;
        AgentConfigError = null;
        LLMParametersError = null;

        try
        {
            // Force InvariantCulture for JSON deserialization
            var previousCulture = CultureInfo.CurrentCulture;
            try
            {
                CultureInfo.CurrentCulture = CultureInfo.InvariantCulture;

                var baseUri = Navigation.BaseUri.TrimEnd('/');
                var response = await Http.GetAsync($"{baseUri}/api/config");

                if (response.IsSuccessStatusCode)
                {
                    var config = await response.Content.ReadFromJsonAsync<ConfigResponse>(JsonOptions);
                    if (config != null)
                {
                    OriginalSystemPrompt = config.Agent?.SystemPrompt ?? "";
                    EditedSystemPrompt = OriginalSystemPrompt;

                    OriginalContextWindowSize = config.Agent?.ContextWindowSize ?? 20;
                    ContextWindowSize = OriginalContextWindowSize;

                    OriginalTemperature = config.LLM?.Temperature ?? 0.7;
                    OriginalMaxTokens = config.LLM?.MaxTokens ?? 1000;
                    OriginalTopP = config.LLM?.TopP ?? 1.0;

                    Temperature = OriginalTemperature;
                    MaxTokens = OriginalMaxTokens;
                    TopP = OriginalTopP;
                }
            }
            else
            {
                LoadError = $"Failed to load configuration: {response.StatusCode}";
            }
            }
            finally
            {
                CultureInfo.CurrentCulture = previousCulture;
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveSystemPromptAsync()
    {
        IsSavingSystemPrompt = true;
        SystemPromptSuccess = false;
        SystemPromptError = null;

        try
        {
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await Http.PutAsJsonAsync($"{baseUri}/api/config/system-prompt",
                new { SystemPrompt = EditedSystemPrompt });

            if (response.IsSuccessStatusCode)
            {
                OriginalSystemPrompt = EditedSystemPrompt;
                SystemPromptSuccess = true;

                // Hide success message after 3 seconds
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    SystemPromptSuccess = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                SystemPromptError = $"Failed to save: {error}";
            }
        }
        catch (Exception ex)
        {
            SystemPromptError = $"Error: {ex.Message}";
        }
        finally
        {
            IsSavingSystemPrompt = false;
        }
    }

    private async Task SaveAgentConfigAsync()
    {
        IsSavingAgentConfig = true;
        AgentConfigSuccess = false;
        AgentConfigError = null;

        try
        {
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await Http.PutAsJsonAsync($"{baseUri}/api/config/agent-config",
                new { ContextWindowSize });

            if (response.IsSuccessStatusCode)
            {
                OriginalContextWindowSize = ContextWindowSize;
                AgentConfigSuccess = true;

                // Hide success message after 3 seconds
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    AgentConfigSuccess = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                AgentConfigError = $"Failed to save: {error}";
            }
        }
        catch (Exception ex)
        {
            AgentConfigError = $"Error: {ex.Message}";
        }
        finally
        {
            IsSavingAgentConfig = false;
        }
    }

    private async Task SaveLLMParametersAsync()
    {
        IsSavingLLMParameters = true;
        LLMParametersSuccess = false;
        LLMParametersError = null;

        try
        {
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await Http.PutAsJsonAsync($"{baseUri}/api/config/llm-parameters",
                new
                {
                    Temperature,
                    MaxTokens,
                    TopP
                });

            if (response.IsSuccessStatusCode)
            {
                OriginalTemperature = Temperature;
                OriginalMaxTokens = MaxTokens;
                OriginalTopP = TopP;
                LLMParametersSuccess = true;

                // Hide success message after 3 seconds
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    LLMParametersSuccess = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                LLMParametersError = $"Failed to save: {error}";
            }
        }
        catch (Exception ex)
        {
            LLMParametersError = $"Error: {ex.Message}";
        }
        finally
        {
            IsSavingLLMParameters = false;
        }
    }

    private async Task HandleClose()
    {
        // Close via UIControlService
        await Task.Run(() =>
            UIControlService.UpdateConfigurationPage(visible: false));
    }

    private class ConfigResponse
    {
        public AgentConfig? Agent { get; set; }
        public LLMConfig? LLM { get; set; }
    }

    private class AgentConfig
    {
        public string? SystemPrompt { get; set; }
        public int ContextWindowSize { get; set; }
        public bool EnableTools { get; set; }
    }

    private class LLMConfig
    {
        public string? Provider { get; set; }
        public double? Temperature { get; set; }
        public int MaxTokens { get; set; }
        public double? TopP { get; set; }
    }
}
