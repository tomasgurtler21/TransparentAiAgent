@page "/"
@using TransparentAiAgentGui.Services
@using TransparentAiAgentGui.Models
@using TransparentAiAgentGui.Components.Chat
@using TransparentAiAgentGui.Components.ConversationHistory
@using TransparentAiAgentGui.Components.LLMProvider
@using TransparentAiAgentGui.Components.Scenarios
@using TransparentAiAgentGui.Components.Shared
@using TransparentAiAgentCore.Domain.UIControl
@using TransparentAiAgentCore.Domain.Memory
@using TransparentAiAgentCore.Infrastructure.Configuration
@using Microsoft.JSInterop
@inject IConversationUIService ConversationService
@inject global::TransparentAiAgentCore.Domain.UIControl.IAppModeService AppModeService
@inject IServiceProvider ServiceProvider
@inject ILongTermMemoryService MemoryService
@inject IUserSettingsService UserSettingsService
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Transparent AI Agent</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <h1>Transparent AI Agent</h1>
        @if (AppModeService.CurrentMode == AppMode.Teaching)
        {
            <ScenarioIndicator />
        }
        <button @onclick="HandleEndConversationClick" class="clear-button">End Conversation</button>
    </div>

    <div class="selectors-row">
        <div class="conversation-selector-container">
            <ConversationSelector />
        </div>
        @if (IsProviderSelectorAvailable)
        {
            <div class="provider-selector-container">
                <ProviderSelector />
            </div>
        }
    </div>

    @* Long-term memory control *@
    <div class="memory-control">
        <label class="memory-checkbox">
            <input type="checkbox"
                   @bind="isMemoryEnabled"
                   @bind:after="OnMemoryToggled" />
            <span>Use long-term memory</span>
            <span class="info-icon"
                  title="Allow agent to remember your preferences and context across conversations">
                ℹ️
            </span>
        </label>

        @if (isMemoryEnabled && hasMemory)
        {
            <div class="memory-actions">
                <button class="btn-link btn-sm" @onclick="ViewMemory">View</button>
                <button class="btn-link btn-sm" @onclick="ClearMemory">Clear</button>
            </div>
        }
    </div>

    <MessageList @ref="_messageList" Messages="ConversationService.Messages" IsProcessing="ConversationService.IsProcessing" />

    <ChatInput OnSend="HandleSendMessage" IsDisabled="ConversationService.IsProcessing" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            @errorMessage
        </div>
    }
</div>

<MemoryViewerOverlay @ref="memoryViewer" />

@code {
    private string? errorMessage;
    private bool IsProviderSelectorAvailable => ServiceProvider.GetService<IProviderStateService>() != null;

    // Memory-related fields
    private bool isMemoryEnabled = false;
    private bool hasMemory = false;
    private bool hasLoadedFromStorage = false;
    private MemoryViewerOverlay memoryViewer = default!;

    // Message list reference for auto-scroll
    private MessageList _messageList = default!;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to UI service events
        ConversationService.MessagesChanged += OnMessagesChanged;
        ConversationService.ProcessingStateChanged += OnProcessingStateChanged;
        ConversationService.StreamingMessageUpdated += OnStreamingMessageUpdated;
        ConversationService.MemoryStateChanged += OnMemoryStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hasLoadedFromStorage)
        {
            hasLoadedFromStorage = true;

            // Restore checkbox state from UserSettings (primary source of truth)
            var userSettings = UserSettingsService.GetCurrentSettings();
            isMemoryEnabled = userSettings.EnableMemory;

            // Also check localStorage for backwards compatibility (if different, update settings)
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "memory_enabled");
            if (bool.TryParse(stored, out var localStorageValue) && localStorageValue != isMemoryEnabled)
            {
                // Migrate from localStorage to UserSettings
                isMemoryEnabled = localStorageValue;
                UserSettingsService.UpdateEnableMemory(isMemoryEnabled);
            }

            // Apply the memory state to conversation service
            await ConversationService.SetMemoryEnabledAsync(isMemoryEnabled);

            // Check if memory exists for current mode
            hasMemory = await MemoryService.HasMemoryAsync(AppModeService.CurrentMode);

            StateHasChanged(); // Trigger re-render with updated state
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task HandleSendMessage(string message)
    {
        errorMessage = null;

        try
        {
            // Trigger auto-scroll when user sends a message
            if (_messageList != null)
            {
                await _messageList.ScrollToBottomAsync();
            }

            // Use streaming mode with full tool call support
            await ConversationService.SendMessageStreamingAsync(message);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void OnStreamingMessageUpdated(object? sender, StreamingMessageUpdate update)
    {
        // Trigger UI update when streaming message is updated
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleEndConversationClick()
    {
        // Trigger memory update prompt if enabled
        await ConversationService.EndConversationAsync();

        // Then clear conversation
        await ConversationService.ClearConversationAsync();
        errorMessage = null;
    }

    private async Task OnMemoryToggled()
    {
        // Persist to localStorage (for backwards compatibility)
        await JSRuntime.InvokeVoidAsync("localStorage.setItem",
            "memory_enabled", isMemoryEnabled.ToString());

        // Update UserSettings (this is what ToolManager reads)
        UserSettingsService.UpdateEnableMemory(isMemoryEnabled);

        await ConversationService.SetMemoryEnabledAsync(isMemoryEnabled);

        if (isMemoryEnabled)
        {
            hasMemory = await MemoryService.HasMemoryAsync(AppModeService.CurrentMode);
        }
    }

    private async Task ViewMemory()
    {
        await memoryViewer.ShowAsync();
    }

    private async Task ClearMemory()
    {
        // Simple confirmation using browser confirm dialog
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Are you sure you want to clear all long-term memory for this mode? This action cannot be undone.");

        if (confirmed)
        {
            var result = await MemoryService.UpdateMemoryAsync(
                AppModeService.CurrentMode,
                string.Empty);

            if (result.Success)
            {
                hasMemory = false;
                StateHasChanged();
            }
            else
            {
                errorMessage = $"Failed to clear memory: {result.Error}";
            }
        }
    }

    private void OnMessagesChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProcessingStateChanged(object? sender, bool isProcessing)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnMemoryStateChanged(object? sender, EventArgs e)
    {
        // Refresh hasMemory flag when memory state changes (e.g., LLM created/updated memory)
        InvokeAsync(async () =>
        {
            hasMemory = await MemoryService.HasMemoryAsync(AppModeService.CurrentMode);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ConversationService.MessagesChanged -= OnMessagesChanged;
        ConversationService.ProcessingStateChanged -= OnProcessingStateChanged;
        ConversationService.StreamingMessageUpdated -= OnStreamingMessageUpdated;
        ConversationService.MemoryStateChanged -= OnMemoryStateChanged;
    }
}
