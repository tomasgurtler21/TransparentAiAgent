{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "TransparentAiAgent": {
    "Agent": {
      "SystemPrompt": "You are a helpful AI assistant.",
      "ContextWindowSize": 20
    },
    "LLM": {
      "Provider": "AzureOpenAI",
      "Temperature": 0.7,
      "TopP": 1.0,
      "MaxTokens": 4096,
      "AzureOpenAI": {
        // Choose authentication mode: "ApiKey", "DefaultAzureCredential", or "InteractiveBrowserCredential"
        // - ApiKey: Use static API key (requires ApiKey field below)
        // - DefaultAzureCredential: Use automated credentials (environment, CLI, managed identity, etc.)
        // - InteractiveBrowserCredential: Opens browser popup for interactive login (recommended for GUI apps)
        "AuthenticationMode": "",
        "Endpoint": "",
        // ApiKey only needed when AuthenticationMode is "ApiKey"
        "ApiKey": "",
        "DeploymentName": "",
        "ApiVersion": "2024-02-15-preview"
        // Optional: Specify tenant ID for OAuth authentication (DefaultAzureCredential or InteractiveBrowserCredential)
        // "TenantId": ""
      },
      "Anthropic": {
        "ApiKey": "",
        "Model": "claude-3-sonnet-20240229"
      }
    },
    "MCP": {
      "Enabled": false,
      "ServerPaths": []
    }
  }
}
