{
  "TransparentAiAgent": {
    "Agent": {
      "SystemPrompt": "You are helpful AI assistant",
      "ContextWindowSize": 20,
      "EnableTools": true,
      "ToolExecutionMode": "Sequential"
    },
    "LLM": {
      "ActiveProvider": "claude-haiku",
      "DefaultParameters": {
        "Temperature": 0.7,
        "TopP": 1.0,
        "MaxTokens": 4096
      },
      "Providers": {
        "claude-haiku": {
          "Type": "Anthropic",
          "DisplayName": "Claude Haiku",
          "Parameters": {
            "Model": "claude-haiku-4-5-20251001",
            "ApiKey": "",
            "ExtendedThinking": {
              "Enabled": false
            }
          }
        },
        "claude-sonnet": {
          "Type": "Anthropic",
          "DisplayName": "Claude Sonnet",
          "Parameters": {
            "Model": "claude-sonnet-4-5-20251001",
            "ApiKey": "",
            "ExtendedThinking": {
              "Enabled": true,
              "BudgetTokens": 10000
            }
          },
          "ParameterOverrides": {
            "MaxTokens": 8192
          }
        },
        "azure-gpt4": {
          "Type": "AzureOpenAI",
          "DisplayName": "Azure GPT-4",
          "Parameters": {
            "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
            "DeploymentName": "gpt-4",
            "ApiKey": "",
            "ApiVersion": "2024-02-15-preview",
            "AuthenticationMode": "ApiKey"
          }
        },
        "azure-o3-mini": {
          "Type": "AzureOpenAI",
          "DisplayName": "Azure o3-mini (Reasoning)",
          "Parameters": {
            "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
            "DeploymentName": "o3-mini",
            "ApiKey": "",
            "ApiVersion": "2024-02-15-preview",
            "AuthenticationMode": "ApiKey",
            "IsReasoningModel": true
          },
          "ParameterOverrides": {
            "Temperature": null,
            "TopP": null
          }
        },
        "openai-gpt4": {
          "Type": "OpenAI",
          "DisplayName": "OpenAI GPT-4",
          "Parameters": {
            "Model": "gpt-4o",
            "ApiKey": ""
          }
        },
        "openai-o1": {
          "Type": "OpenAI",
          "DisplayName": "OpenAI o1-preview (Reasoning)",
          "Parameters": {
            "Model": "o1-preview",
            "ApiKey": "",
            "IsReasoningModel": true
          },
          "ParameterOverrides": {
            "Temperature": null,
            "TopP": null
          }
        }
      }
    },
    "MCP": {
      "Servers": [
        {
          "Name": "todo-list",
          "Command": "npx",
          "Args": [
            "-y",
            "@anthropic/mcp-server-todo-list"
          ],
          "Env": {}
        }
      ],
      "AutoDiscoverTools": true,
      "ToolExecutionTimeoutSeconds": 180,
      "MaxToolCallDepth": 10
    }
  }
}