{
  "TransparentAiAgent": {
    "Agent": {
      "SystemPrompt": "You are helpful AI assistant",
      "ContextWindowSize": 20,
      "EnableTools": true,
      "ToolExecutionMode": "Sequential"
    },
    "LLM": {
      "ActiveProvider": "claude-haiku",
      "DefaultParameters": {
        "Temperature": 0.7,
        "TopP": 1.0,
        "MaxTokens": 4096
      },
      "Providers": {
        "claude-haiku": {
          "Type": "Anthropic",
          "DisplayName": "Claude Haiku",
          "Parameters": {
            "Model": "claude-haiku-4-5-20251001",
            "ApiKey": "",
            "ExtendedThinking": {
              "Enabled": false
            }
          }
        },
        "claude-sonnet": {
          "Type": "Anthropic",
          "DisplayName": "Claude Sonnet",
          "Parameters": {
            "Model": "claude-sonnet-4-5-20251001",
            "ApiKey": "",
            "ExtendedThinking": {
              "Enabled": true,
              "BudgetTokens": 10000
            }
          },
          "ParameterOverrides": {
            "MaxTokens": 8192
          }
        },
        "openai-gpt5-mini": {
          "Type": "OpenAI",
          "DisplayName": "OpenAI GPT-5-mini",
          "Parameters": {
            "Model": "gpt-5-mini",
            "ApiKey": "",
            "IsReasoningModel": true
          }
        }
      }
    },
    "MCP": {
      "Servers": [
        {
          "Name": "todo-list",
          "Command": "npx",
          "Args": [
            "-y",
            "@anthropic/mcp-server-todo-list"
          ],
          "Env": {}
        }
      ],
      "AutoDiscoverTools": true,
      "ToolExecutionTimeoutSeconds": 180,
      "MaxToolCallDepth": 10
    },
    "LongTermMemory": {
      "Enabled": true,
      "StorageDirectory": "data/memory",
      "MaxCharacters": 10000,
      "AutoLoadOnStart": true,
      "PromptUpdateOnEnd": true,
      "UpdatePromptTimeoutSeconds": 30
    }
  }
}