{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "TransparentAiAgent": "Debug"
    }
  },

  "TransparentAiAgent": {
    "Agent": {
      "SystemPrompt": "You are a helpful AI assistant. This is a development environment.",
      "ContextWindowSize": 20
    },
    "LLM": {
      "Provider": "AzureOpenAI",
      "Temperature": 0.7,
      "TopP": 1.0,
      "MaxTokens": 4096,
      "AzureOpenAI": {
        // Choose authentication mode: "ApiKey", "DefaultAzureCredential", or "InteractiveBrowserCredential"
        // - ApiKey: Use static API key (requires ApiKey field)
        // - DefaultAzureCredential: Use automated credentials (environment, CLI, managed identity, etc.)
        // - InteractiveBrowserCredential: Opens browser popup for interactive login (best for GUI apps)
        "AuthenticationMode": "InteractiveBrowserCredential",
        "Endpoint": "https://your-resource.openai.azure.com/",
        // ApiKey only needed when AuthenticationMode is "ApiKey"
        // "ApiKey": "your-api-key-here",
        "DeploymentName": "your-deployment-name",
        "ApiVersion": "2024-02-15-preview"
        // Optional: Specify tenant ID for OAuth authentication
        // "TenantId": "your-tenant-id"
      }
    },
    "MCP": {
      "Enabled": false,
      "ServerPaths": []
    }
  }
}
